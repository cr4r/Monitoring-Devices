# ================================================================
# DevWatch — .gitignore
# ================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Production Build & Bundles
dist/
dist-ssr/
*.local

# Database & SQLite Storage
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/backups/
server/data/*.db
server/data/*.db-journal
server/data/*.db-wal
server/data/*.db-shm
server/data/backups/
**/data/*.db*
**/backups/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# SSL / TLS Private Keys & Certificates
ssl/*.key
ssl/*.crt
ssl/*.pem
ssl/*.pfx
server/ssl/*.key
server/ssl/*.crt
server/ssl/*.pem
!ssl/.gitkeep
!server/ssl/.gitkeep

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln