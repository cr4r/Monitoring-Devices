# ================================================================
# DevWatch — Environment Configuration Template (.env-example)
# Salin file ini menjadi .env sebelum menjalankan aplikasi:
# Windows (PowerShell): Copy-Item .env-example .env
# Linux / macOS: cp .env-example .env
# ================================================================

# --- Pengaturan Server Express ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# --- Autentikasi & Keamanan JWT ---
# PENTING: Ganti JWT_SECRET dengan string acak yang aman dan rahasia di produksi!
JWT_SECRET=devwatch-secret-jwt-key-2026-secure-token
JWT_EXPIRES_IN=24h

# --- Basis Data SQLite (Modul Bawaan node:sqlite) ---
DB_PATH=./data/devwatch.db

# --- Parameter Monitoring & Probe Jaringan ---
# Batas waktu timeout ICMP ping (dalam milidetik)
PING_TIMEOUT_MS=2000

# Interval default pengecekan perangkat (dalam detik)
DEFAULT_INTERVAL_SECONDS=60

# Ambang batas kegagalan berturut-turut sebelum status dinyatakan OFFLINE
FAILURE_THRESHOLD=3

# --- Konfigurasi HTTPS / TLS Mandiri (Opsional) ---
# Ubah ke true jika ingin mengaktifkan native HTTPS di server Node.js
# Buat sertifikat dengan perintah: npm run cert:generate
USE_HTTPS=false
SSL_KEY_PATH=./ssl/server.key
SSL_CERT_PATH=./ssl/server.crt
